// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nickname   String
  birth      DateTime  @db.Date
  profileImg String?   @map("profile_img")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  account  Account?
  boards   Board[]
  comments Comment[]
  votes    Vote[]

  @@map("users")
}

model Account {
  id     String @id @db.Uuid
  userId String @map("user_id")
  pw     String

  user User @relation(fields: [id], references: [id])

  @@map("accounts")
}

model Board {
  idx       Int       @id @default(autoincrement())
  authorId  String    @map("author_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  author     User            @relation(fields: [authorId], references: [id])
  options    BoardOption[]
  snapshots  BoardSnapshot[]
  comments   Comment[]
  categories BoardCategory[]

  @@map("boards")
}

model BoardOption {
  idx       Int    @id @default(autoincrement())
  boardIdx  Int    @map("board_idx")
  sortOrder Int    @default(1) @map("sort_order") @db.SmallInt
  contents  String
  count     Int    @default(0)

  board    Board     @relation(fields: [boardIdx], references: [idx])
  votes    Vote[]
  comments Comment[]

  @@map("board_options")
}

model BoardSnapshot {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boardIdx      Int      @map("board_idx")
  thumbnailPath String?  @map("thumbnail_path")
  title         String
  contents      String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  board Board @relation(fields: [boardIdx], references: [idx])

  @@index([boardIdx, createdAt(sort: Desc)], name: "board_snapshots_latest_idx")
  @@map("board_snapshots")
}

model Comment {
  idx       Int       @id @default(autoincrement())
  boardIdx  Int       @map("board_idx")
  authorId  String    @map("author_id") @db.Uuid
  optionIdx Int       @map("option_idx")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  board     Board             @relation(fields: [boardIdx], references: [idx])
  author    User              @relation(fields: [authorId], references: [id])
  option    BoardOption       @relation(fields: [optionIdx], references: [idx])
  snapshots CommentSnapshot[]

  @@map("comments")
}

model CommentSnapshot {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  commentIdx Int      @map("comment_idx")
  contents   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  comment Comment @relation(fields: [commentIdx], references: [idx])

  @@index([commentIdx, createdAt(sort: Desc)], name: "comment_snapshots_latest_idx")
  @@map("comment_snapshots")
}

model Category {
  idx       Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  boards BoardCategory[]

  @@map("categories")
}

model BoardCategory {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  boardIdx    Int    @map("board_idx")
  categoryIdx Int    @map("category_idx")

  board    Board    @relation(fields: [boardIdx], references: [idx])
  category Category @relation(fields: [categoryIdx], references: [idx])

  @@map("board_categories")
}

model Vote {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  optionIdx Int      @map("option_idx")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User        @relation(fields: [userId], references: [id])
  option BoardOption @relation(fields: [optionIdx], references: [idx])

  @@map("votes")
}
